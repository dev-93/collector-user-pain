# === Notion ===
NOTION_TOKEN=
# 문제 수집함 DB ID
NOTION_PROBLEM_DB_ID=
# 검증 실험실 DB ID
NOTION_VALIDATION_DB_ID=

# === AI — 폴백 체인: OpenRouter → Groq → Gemini ===
# 키가 설정된 provider만 체인에 포함됨 (모델 설정은 src/config/index.js)
# 무료 한도: OpenRouter 일 200회 / Groq 일 14,400회 / Gemini 분당 15회
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# === 네이버 API ===
# https://developers.naver.com/products/service-api/search/search.nhn 에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 수집 설정 ===
# AI로 분석할 상위 건수 (하루 API 한도 보호 — 배치 분석으로 2회 호출)
AI_LIMIT=15
# Notion에 저장할 최상위 건수 (DB 과적 방지)
NOTION_TOP_N=5
