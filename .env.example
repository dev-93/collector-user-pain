# === Notion ===
NOTION_TOKEN=
# Problem DB ID (setup-notion.js 실행 후 채워넣기)
NOTION_PROBLEM_DB_ID=
# 태남 무기 DB ID
NOTION_WEAPON_DB_ID=

# === AI Provider 전환 ===
# gemini (기본) 또는 openrouter
AI_PROVIDER=gemini

# === AI (Gemini) ===
GEMINI_API_KEY=

# === AI (OpenRouter) — Gemini 할당량 소진 시 대체 ===
OPENROUTER_API_KEY=
# 사용할 모델 (기본: nvidia/nemotron-3-ultra-550b-a55b:free)
# 다른 무료 모델: google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# === 네이버 API ===
# https://developers.naver.com/apps 에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 수집 설정 ===
# 불평 시그널 키워드 (쉼표 구분, 기본값 사용 가능)
# COMPLAINT_KEYWORDS=방법이 없나,너무 불편,매번 이렇게,왜 이런 기능,대신 해주는 곳
# 최소 점수 (이 이상만 Notion 저장)
MIN_SCORE=50
# AI로 분석할 상위 건수 (하루 API 한도 보호 — 배치 분석으로 2회 호출)
AI_LIMIT=15
# Notion에 저장할 최상위 건수 (DB 과적 방지)
NOTION_TOP_N=5
