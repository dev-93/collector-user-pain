# === Notion ===
NOTION_TOKEN=
# 문제 수집함 DB ID
NOTION_PROBLEM_DB_ID=
# 검증 실험실 DB ID
NOTION_VALIDATION_DB_ID=

# === AI — 폴백 체인: OpenRouter → Groq → Gemini ===
# 키가 설정된 provider만 체인에 포함됨 (모델 설정은 src/config/index.js)
# 사용 한도·요금·모델 가용성은 각 공급자의 현재 계정 설정에서 확인
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 수집 설정 ===
# AI로 분석할 상위 건수 (최대 5로 제한; 무료 티어에서 한 배치만 사용)
AI_LIMIT=5

# === 아침 배치 (명시적으로 활성화할 때만 사용) ===
RADAR_SOURCES_FILE=config/sources.json
# Railway Volume을 /data에 연결한 경우 /data/problem-radar 사용
RADAR_STATE_DIR=data/batch
RADAR_SEND_REPORT=false
