
# === Notion ===
NOTION_TOKEN=
# 문제 수집함 DB ID
NOTION_PROBLEM_DB_ID=
# 검증 실험실 DB ID
NOTION_VALIDATION_DB_ID=

# === AI Provider 전환 ===
# gemini       → Gemini API만 사용
# openrouter   → OpenRouter 1차 호출, 429 한도 초과 시 Gemini로 자동 폴백
#               (두 키를 모두 설정하면 폴백이 활성화됨)
AI_PROVIDER=openrouter

# === AI (Gemini) — 메인 또는 OpenRouter 폴백용 ===
# 무료 한도: 분당 15회, 일 1500회 (Flash 기준)
GEMINI_API_KEY=

# === AI (OpenRouter) — 1차 호출 ===
# 무료 모델 사용 시 분당 20회 / 일 200회 한도 적용
OPENROUTER_API_KEY=
# 사용할 모델 (기본: google/gemma-4-26b-a4b-it:free, 한국어 품질 우수)
# 대안 모델: nvidia/nemotron-3-ultra-550b-a55b:free (크지만 느림)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# === 네이버 API ===
# 2026년 6월 이후 NAVER API HUB로 이관
# https://console.ncloud.com → Application Services → NAVER API HUB 에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 수집 설정 ===
# 최소 점수 (이 이상만 Notion 저장)
MIN_SCORE=50
# AI로 분석할 상위 건수 (하루 API 한도 보호 — 배치 분석으로 2회 호출)
AI_LIMIT=15
# Notion에 저장할 최상위 건수 (DB 과적 방지)
NOTION_TOP_N=5
