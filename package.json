{
  "name": "problem-radar",
  "version": "0.1.0",
  "description": "원문 근거와 고객 손실을 검토하는 문제 조사 보조 도구",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "collect": "node --env-file=.env src/index.js --collect",
    "top": "node --env-file=.env src/index.js --top",
    "validate": "node --env-file=.env src/index.js --validate",
    "valstat": "node --env-file=.env src/index.js --valstat",
    "bot": "node --env-file=.env src/services/telegram-bot.js",
    "setup:notion": "node --env-file=.env scripts/setup-notion.js",
    "setup:validation": "node --env-file=.env scripts/setup-validation-db.js",
    "dev": "node --env-file=.env src/index.js",
    "test": "node --test tests/*.test.js",
    "review": "node scripts/review-collection.js",
    "compare": "node scripts/compare-pipeline.js",
    "daily": "node scripts/daily.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@notionhq/client": "^2.2.15",
    "dotenv": "^16.4.7",
    "node-telegram-bot-api": "^0.66.0"
  },
  "author": "Taenami",
  "license": "MIT"
}
